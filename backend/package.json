{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "src/server.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest watch",
    "test:ci": "vitest run",
    "lint": "eslint src/ && tsc --noEmit",
    "db:reset": "tsx scripts/reset_db.ts",
    "db:migrate": "tsx src/migrate_db.ts",
    "db:migrate:prod": "node dist/migrate_db.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.20.0",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "pg": "^8.16.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.1.0",
    "globals": "^17.4.0",
    "rimraf": "^5.0.10",
    "supertest": "^7.1.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "bcrypt@6.0.0",
      "esbuild"
    ],
    "overrides": {
      "body-parser": ">=2.3.0",
      "qs": ">=6.15.3",
      "path-to-regexp": ">=8.4.2",
      "minimatch": ">=9.0.7",
      "picomatch": ">=4.0.4",
      "form-data": ">=4.0.6",
      "brace-expansion": ">=5.0.7"
    }
  }
}