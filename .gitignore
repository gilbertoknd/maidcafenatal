# ===========================
# 1. Dependências e Logs (Geral)
# ===========================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ===========================
# 2. Variáveis de Ambiente (CRÍTICO DE SEGURANÇA)
# ===========================
# Nunca envie suas senhas e chaves para o GitHub
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env

# ===========================
# 3. Frontend (Vue.js / Vite)
# ===========================
# Pasta de build de produção (o código compilado)
frontend/dist/
frontend/.output/

# Arquivos temporários de editores/testes
frontend/.eslintcache

# ===========================
# 4. Backend (Node.js / Express)
# ===========================
# Relatórios de cobertura de testes
coverage/
backend/coverage/
# Build de produção
dist/
build/

# Logs gerados pelo servidor (opcional, mas recomendado)
logs/
*.log
pid
pids
*.pid

# ===========================
# 5. Sistema Operacional e IDEs
# ===========================
# macOS
.DS_Store

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# VS Code / Editores
.vscode/
.idea/
*.swp
*.swo

# ===========================
# 6. Docker & Banco de Dados Local
# ===========================
# Ignora a pasta onde o Postgres salva os dados na sua máquina
# (Isso evita subir seu banco de dados inteiro para o Git)
pgdata/
postgres_data/
/data/db/

# ===========================
# 7. Testes
# ===========================
backend/coverage*.txt
frontend/coverage*.txt
# Artefatos de upload gerados pelas suítes de teste do backend: o multer grava
# no diretório real (public/images e public/fonts). Ignorados por PADRÃO (não por
# nome), pois cada `pnpm test:ci` cria novos arquivos com hash aleatório. Os nomes
# batem com as fixtures dos testes: test.jpg / event.jpg / post.jpg / minha-fonte.woff2.
backend/public/images/*-test.jpg
backend/public/images/*-event.jpg
backend/public/images/*-post.jpg
backend/public/fonts/*-minha-fonte.woff2
frontend/test_output_verbose.txt
frontend/test_output.txt
frontend/test_results.txt

.agents
coverage*.txt
backup_log.txt
